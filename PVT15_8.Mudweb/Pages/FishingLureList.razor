@page "/FishingLure"
@attribute [Authorize]
@using PVT15_8.Shared.DTOs
@using Microsoft.AspNetCore.Components.Web
@inject AdminService AdminService

<PageTitle>Fiskedrag</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="my-4">
    <div class="top-bar">
            <MudTextField @bind-Value="searchTerm"
                          Placeholder="Sök bete"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Class="search-input"
                          OnKeyUp="OnSearchKeyUp" />
        <div class="filter-container">
            <MudMenu Icon="@Icons.Material.Filled.FilterAlt"
                     Size="Size.Large"
                     Class="filter-menu-button"
                     AnchorOrigin="Origin.BottomLeft"
                     TransformOrigin="Origin.TopLeft">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="px-4 py-2">Bete typ</MudText>
                <MudMenuItem OnClick="() => SetTypeFilter(FilterAll)">
                    <MudText Typo="Typo.body2">Alla typer</MudText>
                </MudMenuItem>
                @foreach (var type in lureTypes)
                {
                    <MudMenuItem OnClick="() => SetTypeFilter(type)">
                        <MudText Typo="Typo.body2">@type</MudText>
                    </MudMenuItem>
                }
                <MudDivider />
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="px-4 py-2">Målfisk</MudText>
                <MudMenuItem OnClick="() => SetSpeciesFilter(FilterAll)">
                    <MudText Typo="Typo.body2">Alla fiskar</MudText>
                </MudMenuItem>
                @foreach (var species in allSpeciesNames)
                {
                    <MudMenuItem OnClick="() => SetSpeciesFilter(species)">
                        <MudText Typo="Typo.body2">@species</MudText>
                    </MudMenuItem>
                }
            </MudMenu>
        </div>
    </div>

    <div style="height: auto; overflow-y: auto; margin-top: 20px;">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            @foreach (var lure in filteredLures)
            {
                var isExpanded = expandedLureId == lure.Id;
                var cardClass = (filteredLures.IndexOf(lure) % 2 == 0) ? "card-even" : "card-odd";
                var imgSrc = string.IsNullOrEmpty(lure.ImageUrl) ? defaultImageUrl : lure.ImageUrl;

                <MudItem xs="12" Style="width: 100%;">
                    <MudCard Class="@($"{cardClass} clickable-card")" Style="border-radius: 16px; overflow: hidden;">
                        
                        @if (!isExpanded)
                        {
                            <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Stretch" @onclick="() => ToggleCard(lure.Id)">
                                
                                <MudImage Src="@imgSrc" ObjectFit="ObjectFit.Cover" Style="width: auto; height: 110px; flex-shrink: 0;" />
                                
                                <MudStack Justify="Justify.Center" Spacing="0" Class="pa-3" Style="flex: 1; overflow: hidden;">
                                    <MudText Typo="Typo.h6" Class="font-weight-bold text-truncate">@lure.Name</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-1">@lure.Type</MudText>
                                    <MudText Typo="Typo.body2" Class="description-collapsed">
                                        Målfisk: @string.Join(", ", lure.Species.Select(s => s.Name))
                                    </MudText>
                                </MudStack>

                            </MudStack>
                        }
                        else
                        {
                            <MudStack Spacing="0" @onclick="() => ToggleCard(lure.Id)">
                                
                                <div style="width: 100%; height: 250px; background-color: #f5f7fa; display: flex; justify-content: center; align-items: center;">
                                    <MudImage Src="@imgSrc" ObjectFit="ObjectFit.Contain" Style="max-width: 100%; max-height: 100%; padding: 8px;" />
                                </div>
                                
                                <MudStack Spacing="1" Class="pa-4 text-center">
                                    <MudText Typo="Typo.h5" Class="font-weight-bold">@lure.Name</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-2">@lure.Type</MudText>
                                    
                                    <MudText Typo="Typo.body2" Class="mt-2">
                                        <strong>Målfisk:</strong> @string.Join(", ", lure.Species.Select(s => s.Name))
                                    </MudText>
                                </MudStack>

                            </MudStack>
                        }
                    </MudCard>
                </MudItem>
            }
        </MudStack>
    </div>
</MudContainer>

<style>
    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .search-input {
        margin: 0;
    }

        .search-input ::deep .mud-input-outlined:hover fieldset,
        .search-input ::deep .mud-input-outlined.mud-input-focused fieldset {
            border: none !important;
        }

        .search-input ::deep .mud-input-outlined .mud-input-adorned-end {
            padding-right: 8px;
        }

    .filter-container {
        background: white;
        border-radius: 50%;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .filter-menu-button .mud-icon-button {
        background-color: white;
        border-radius: 50%;
        width: 48px;
        height: 48px;
        transition: background-color 0.2s;
    }

        .filter-menu-button .mud-icon-button:hover {
            background-color: #f5f5f5;
        }
    
    .clickable-card {
        cursor: pointer;
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

    .card-even {
        background-color: white !important;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .card-odd {
        background-color: #2B7AE314 !important;
        border: 1px solid rgba(0,0,0,0.02);
    }

    .clickable-card:hover {
        transform: scale(1.01);
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }

    .description-collapsed {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        max-height: 3em;
    }
</style>

@code {
    private int? expandedLureId = null;
    private List<FishingLureDTO> allLures = [];
    private List<FishingLureDTO> filteredLures = [];
    private string searchTerm = "";
    private string selectedType = FilterAll;
    private string selectedTargetSpecies = FilterAll;
    private List<string> lureTypes = [];
    private List<string> allSpeciesNames = [];

    private readonly string defaultImageUrl = "https://png.pngtree.com/png-vector/20241227/ourmid/pngtree-fishing-lure-with-hook-essential-gear-for-anglers-png-image_14921980.png";
    private const string FilterAll = "ALL";

    protected override async Task OnInitializedAsync()
    {
        allLures = await AdminService.GetFishingLuresAsync();
        lureTypes = allLures.Select(l => l.Type).Where(t => !string.IsNullOrEmpty(t)).Select(t => t!).Distinct().OrderBy(t => t).ToList();
        allSpeciesNames = allLures.SelectMany(l => l.Species.Select(s => s.Name)).Distinct().OrderBy(n => n).ToList();
        ApplyFilters();
    }

    private void OnSearchKeyUp(KeyboardEventArgs e) => ApplyFilters();

    private void ApplyFilters()
    {
        var query = allLures.AsEnumerable();
        
        if (!string.IsNullOrWhiteSpace(searchTerm))
            query = query.Where(l => l.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        
        if (selectedType != FilterAll)
            query = query.Where(l => l.Type.Equals(selectedType, StringComparison.OrdinalIgnoreCase));
        
        if (selectedTargetSpecies != FilterAll)
            query = query.Where(l => l.Species.Any(s => s.Name.Equals(selectedTargetSpecies, StringComparison.OrdinalIgnoreCase)));
        
        filteredLures = query.ToList();
        expandedLureId = null;
        StateHasChanged();
    }

    private void SetTypeFilter(string type) { selectedType = type; ApplyFilters(); }
    private void SetSpeciesFilter(string species) { selectedTargetSpecies = species; ApplyFilters(); }
    private void ToggleCard(int lureId) => expandedLureId = (expandedLureId == lureId) ? null : lureId;
}