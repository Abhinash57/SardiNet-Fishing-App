@page "/catches"
@using PVT15_8.Shared.DTOs
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Latest Catches</PageTitle>

        <MudContainer MaxWidth="MaxWidth.Medium" Class="my-8" Style="padding-bottom: 80px;">

            <div class="top-bar">
                <div class="search-container">
                    <MudTextField @bind-Value="searchTerm"
                                  Placeholder="Sök efter fiskart eller plats..."
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Class="search-input"
                                  OnKeyUp="OnSearchKeyUp" />
                </div>
                <div class="filter-container">
                    <MudMenu Icon="@Icons.Material.Filled.FilterAlt"
                             Size="Size.Large"
                             Class="filter-menu-button"
                             AnchorOrigin="Origin.BottomLeft"
                             TransformOrigin="Origin.TopLeft">
                        <MudMenuItem OnClick="() => SetSpotFilter(null)">Alla platser</MudMenuItem>
                        @foreach (var spot in fishingSpots)
                        {
                            <MudMenuItem OnClick="() => SetSpotFilter(spot.Id)">@spot.Name</MudMenuItem>
                        }
                    </MudMenu>
                </div>
            </div>

            @if (allCatches == null)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="mt-4" />
            }
            else if (!filteredCatches.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mt-4">Inga fångster matchar dina filter.</MudAlert>
            }
            else
            {
                foreach (var c in filteredCatches)
                {
                    <MudCard Class="mb-4" Elevation="2">
                        <MudCardContent>
                            <MudGrid>
                                <MudItem xs="12" sm="4" md="3" lg="3">
                                    @if (!string.IsNullOrEmpty(c.ImageUrl))
                                    {
                                        <div style="max-width: 250px; margin: 0 auto;">
                                            <MudImage src="@c.ImageUrl" Alt="Fångstbild" Style="width: 100%; height: auto; max-height: 200px; object-fit: contain; border-radius: 8px;" />
                                        </div>
                                    }
                                    else
                                    {
                                        <MudPaper Height="150px" Class="d-flex align-center justify-center" Style="background:#eee; max-width: 250px;">
                                            <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Default" Size="Size.Large" />
                                        </MudPaper>
                                    }
                                </MudItem>
                                <MudItem xs="12" sm="8" md="9" lg="9">
                                    <MudText Typo="Typo.h5" Color="Color.Primary">@c.FishSpeciesName</MudText> 
                                    <MudText Typo="Typo.body1"><b>Plats: </b>@c.FishingSpotName</MudText>
                                    
                                    @if (!string.IsNullOrEmpty(c.FishingLureName))
                                    {
                                        <MudText Typo="Typo.body2"><b>Bete: </b> @c.FishingLureName (@c.FishingLureType)</MudText>
                                    }

                                    <MudText Typo="Typo.body2"><b>Datum: </b> @c.CatchDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                                    
                                    <div class="d-flex gap-4 mt-2">
                                        @if (c.WeightKg > 0) { <MudText Typo="Typo.body2"><b>Vikt: </b>@c.WeightKg kg</MudText> }
                                        @if (c.LengthCm > 0) { <MudText Typo="Typo.body2"><b>Längd: </b>@c.LengthCm cm</MudText> }
                                    </div>
                                    
                                    @if (!string.IsNullOrEmpty(c.Description))
                                    {
                                        <MudText Typo="Typo.body2" Class="mt-2" Style="font-style: italic;">"@c.Description"</MudText>
                                    }

                                </MudItem>
                            </MudGrid>
                        </MudCardContent>
                    </MudCard>
                }
            }
        </MudContainer>

<style>
    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }
    .search-container {
        flex: 1;
        background: white;
        border-radius: 40px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        padding: 4px 8px;
    }
    .search-input {
        margin: 0;
    }
    .search-input ::deep .mud-input-outlined:hover fieldset,
    .search-input ::deep .mud-input-outlined.mud-input-focused fieldset {
        border: none !important;
    }
    .search-input ::deep .mud-input-outlined .mud-input-adorned-end {
        padding-right: 8px;
    }
    .filter-container {
        background: white;
        border-radius: 50%;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .filter-menu-button .mud-icon-button {
        background-color: white;
        border-radius: 50%;
        width: 48px;
        height: 48px;
        transition: background-color 0.2s;
    }
    .filter-menu-button .mud-icon-button:hover {
        background-color: #f5f5f5;
    }
</style>

@code {
    private List<CatchReportDTO>? allCatches;
    private List<CatchReportDTO> filteredCatches = new();
    private List<FishingSpotMarkerDTO> fishingSpots = new();

    private string searchTerm = "";
    private int? selectedSpotId = null;

    protected override async Task OnInitializedAsync()
    {
        var gatewayClient = HttpClientFactory.CreateClient("GatewayClient");

        var catchesTask = gatewayClient.GetFromJsonAsync<List<CatchReportDTO>>("/api/catchreports");
        var spotsTask = gatewayClient.GetFromJsonAsync<List<FishingSpotMarkerDTO>>("/api/fishingspots/markers");

        await Task.WhenAll(catchesTask, spotsTask);

        allCatches = catchesTask.Result ?? new List<CatchReportDTO>();
        fishingSpots = spotsTask.Result ?? new List<FishingSpotMarkerDTO>();

        ApplyFilters();
    }

    private void OnSearchKeyUp(KeyboardEventArgs e) => ApplyFilters();

    private void SetSpotFilter(int? spotId)
    {
        selectedSpotId = spotId;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (allCatches == null) return;

        var query = allCatches.AsEnumerable();

        if (selectedSpotId.HasValue)
        {
            query = query.Where(c => c.FishingSpotId == selectedSpotId.Value);
        }

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query = query.Where(c => 
                (c.FishSpeciesName != null && c.FishSpeciesName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                (c.FishingSpotName != null && c.FishingSpotName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                (c.Description != null && c.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));
        }

        filteredCatches = query.OrderByDescending(c => c.CatchDate).ToList();
        StateHasChanged();
    }
}